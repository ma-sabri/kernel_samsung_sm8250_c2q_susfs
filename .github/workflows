name: Build Note 20 Ultra (c2q) KernelSU-Next + SuSFS

on:
  workflow_dispatch:

jobs:
  build:
    name: Compile SM8250 Kernel
    runs-on: ubuntu-22.04
    steps:
      - name: Maximize Environment & Install Clang Toolchain
        run: |
          sudo rm -rf /usr/share/dotnet /etc/mysql /etc/php /usr/local/lib/android
          sudo apt update
          sudo apt install -y git cpio tar xz-utils bc bison flex libssl-dev make gcc g++ \
                              clang lld llvm gcc-aarch64-linux-gnu binutils-aarch64-linux-gnu \
                              gcc-arm-linux-gnueabi binutils-arm-linux-gnueabi libelf-dev

      - name: Clone Source
        run: |
          git clone --depth=1 https://github.com/postkevone/c2q-kernelsu-next.git kernel
          cd kernel
          git submodule update --init --recursive || true

      - name: Integrate SuSFS 4.19 & Apply Driver Fixes
        working-directory: kernel
        run: |
          # 1. Fetch SuSFS 4.19 patches
          git clone https://gitlab.com/simonpunk/susfs4ksu.git -b kernel-4.19 susfs
          cp -r susfs/kernel_patches/include/linux/susfs* include/linux/ 2>/dev/null || true
          cp -r susfs/kernel_patches/fs/susfs* fs/ 2>/dev/null || true
          cp susfs/kernel_patches/fs/* fs/ 2>/dev/null || true
          cp susfs/kernel_patches/include/linux/* include/linux/ 2>/dev/null || true

          # 2. Fix Clang implicit int / prototype warnings in downstream drivers
          sed -i 's/static debug_display_read_once(/static int debug_display_read_once(/g' techpack/display/msm/samsung/ss_dsi_panel_debug.c 2>/dev/null || true
          sed -i 's/static int mfc_get_chip_id()/static int mfc_get_chip_id(void)/g' security/mstdrv/mstdrv.c 2>/dev/null || true
          sed -i 's/^YYLTYPE yylloc;/extern YYLTYPE yylloc;/' scripts/dtc/dtc-lexer.l 2>/dev/null || true
          sed -i 's/^YYLTYPE yylloc;/extern YYLTYPE yylloc;/' scripts/dtc/dtc-lexer.lex.c_shipped 2>/dev/null || true

          # 3. Apply SuSFS defconfig entries
          TARGET_DEFCONFIG=$(find kernelsu-defconfig/ arch/arm64/configs/ -name "*kona*" -o -name "*c2q*" | head -n 1)
          cat << 'EOF' >> "$TARGET_DEFCONFIG"
          CONFIG_KSU=y
          CONFIG_KSU_SUSFS=y
          CONFIG_SUSFS=y
          CONFIG_KSU_SUSFS_SUS_PATH=y
          CONFIG_KSU_SUSFS_SUS_MOUNT=y
          CONFIG_KSU_SUSFS_SUS_KSTAT=y
          CONFIG_KSU_SUSFS_SUS_SU=y
          CONFIG_KSU_SUSFS_ENABLE_LOG=y
          CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT=y
          CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT=y
          EOF

      - name: Compile Kernel Image
        working-directory: kernel
        run: |
          mkdir -p out
          export ARCH=arm64
          export SUBARCH=arm64
          export CC=clang
          export CLANG_TRIPLE=aarch64-linux-gnu-
          export CROSS_COMPILE=aarch64-linux-gnu-
          export CROSS_COMPILE_ARM32=arm-linux-gnueabi-
          export HOSTCC=clang
          export HOSTCXX=clang++
          export HOSTCFLAGS='-fcommon'

          SRC_DEFCONFIG=$(find kernelsu-defconfig/ -type f | head -n 1)
          cp "$SRC_DEFCONFIG" arch/arm64/configs/c2q_ksu_defconfig

          make ARCH=arm64 O=out CC=clang CLANG_TRIPLE=aarch64-linux-gnu- c2q_ksu_defconfig
          make ARCH=arm64 O=out CC=clang CLANG_TRIPLE=aarch64-linux-gnu- olddefconfig

          make -j$(nproc --all) ARCH=arm64 O=out \
            CC=clang \
            CLANG_TRIPLE=aarch64-linux-gnu- \
            CROSS_COMPILE=aarch64-linux-gnu- \
            CROSS_COMPILE_ARM32=arm-linux-gnueabi- \
            HOSTCC=clang \
            HOSTCXX=clang++ \
            HOSTCFLAGS='-fcommon' \
            KCFLAGS='-w' \
            Image

      - name: Upload Kernel Binary
        uses: actions/upload-artifact@v4
        with:
          name: Image-c2q-KernelSU-Next-SuSFS
          path: kernel/out/arch/arm64/boot/Image
